#!/usr/bin/perl

=head1 NAME

dh_installnuget - install NuGet packages

=head1 SYNOPSIS

B<dh_installnuget> [S<I<debhelper options>>] [B<--nuget-path=>I<path>] [B<-n>]

=head1 DESCRIPTION

B<dh_installnuget> installs NuGet packages to system-wide locations.

By default, packages are installed to F</usr/lib/mono/sdk/8.0.124/nuget/>.
Set B<DH_NUGET_SDK_VERSION> to change the SDK version, or use B<--nuget-path>
to specify a custom installation path.

=head1 FILES

=over 4

=item debian/I<package>.nuget

Lists the NuGet packages to be installed per package. Each line in that file
should be of the form C<I<path>>, where I<path> indicates where the NuGet
package resides in the source tree.

=back

=head1 OPTIONS

=over 4

=item B<--nuget-path=>I<path>

Set the base installation path. Can be specified multiple times.
When used, the default path is B<not> used.

Default (when no --nuget-path specified): F</usr/lib/mono/sdk/8.0.124/nuget/>

Examples:
  --nuget-path=/usr/lib/nuget
  --nuget-path=/usr/lib/nuget --nuget-path=/usr/lib/mono/nuget

=item B<-n>, B<--no-scripts>

Do not modify F<postinst>/F<postrm>/F<prerm> scripts nor add an
activation trigger.

=back

=head1 ENVIRONMENT

=over 4

=item B<DH_NUGET_SDK_VERSION>

Set the Mono SDK version. Default: C<8.0.124>

=back

=head1 NOTES

Note that this command is not idempotent. L<dh_prep(1)> should be called
between invocations of this command. Otherwise, it may cause multiple
instances of the same text to be added to maintainer scripts.

When using custom paths (especially F</usr/local>), be aware that this may
violate Debian Policy and could cause issues with package management. Consider
using standard paths like F</usr/share> or F</usr/lib> for official packages.

=head1 SEE ALSO

L<debhelper(7)>

=head1 AUTHOR

Наследов Дмитрий <dnasledov@lab50.net>
Шлыков Василий <vash@lab50.net>

=cut

use strict;
use warnings;
use Debian::Debhelper::Dh_Lib;
use Digest::SHA qw(sha512_base64 sha256_base64);
use Archive::Zip qw(:ERROR_CODES);
use XML::LibXML;
use File::Basename;

# =============================================================================
# Получение версии SDK (только из переменной окружения)
# =============================================================================
my $sdk_version = $ENV{DH_NUGET_SDK_VERSION} || '8.0.124';
my $default_path = "/usr/lib/mono/sdk/$sdk_version/nuget";

# =============================================================================
# Инициализация
# =============================================================================
my @nuget_paths;
init(options => {
    'nuget-path=s@' => \@nuget_paths,
    'no-scripts|n'  => \$dh{NO_SCRIPTS},
});

# Если пути не указаны — используем путь по умолчанию
@nuget_paths = ($default_path) unless @nuget_paths;

# Нормализация путей (убираем trailing slash)
s/\/+$// foreach @nuget_paths;

verbose_print("SDK version: $sdk_version") if $dh{V};
verbose_print("Paths: @nuget_paths") if $dh{V};

# =============================================================================
# Основная логика
# =============================================================================
foreach my $package (@{$dh{DOPACKAGES}}) {
    my $nugetlistfile = pkgfile(
        {
            'named'                            => 1,
            'support-architecture-restriction' => 0
        },
        $package,
        'nuget'
    );

    next unless $nugetlistfile;

    open(my $fd, '<:encoding(utf8)', $nugetlistfile)
        or error("open $nugetlistfile failed: $!");

    my @nugetfiles;
    while (my $nugetfile = <$fd>) {
        chomp $nugetfile;
        next if $nugetfile =~ /^\s*($|#)/;
        $nugetfile =~ s/^\s+|\s+$//g;  # Пропустить пустые строки и комментарии
        push @nugetfiles, $nugetfile if $nugetfile ne '';
    }
    close $fd;

    foreach my $basepath (@nuget_paths) {
        foreach my $nugetfile (@nugetfiles) {
            error("package $nugetfile not exists") unless -f $nugetfile;

            print("\tInstalling $nugetfile to $basepath\n");

            my ($id, $version) = get_nuget_metadata($nugetfile, $package);
            verbose_print("$nugetfile $id ($version)") if $dh{V};
            
            my $tmpdir = tmpdir($package);
            my $fulldest = "$tmpdir$basepath/" . lc($id) . "/" . lc($version);

            install_dir($fulldest) unless -d $fulldest;

            verbose_print("extracting $nugetfile");
            my $archive = Archive::Zip->new();
            $archive->read($nugetfile) == AZ_OK or error("error opening archive $nugetfile");
            $archive->extractTree('', $fulldest) == AZ_OK or error("failed to extract $nugetfile");

            my $checksumfile = $fulldest . '/' . lc(basename($nugetfile)) . '.sha512';
            verbose_print("generating $checksumfile");
            open(my $fh, '>', $checksumfile) or error("failed to write to $checksumfile");
            print {$fh} sha512_base64($nugetfile);
            close($fh) or error("closing $checksumfile: $!");

            my $metadatafile = "$fulldest/.nupkg.metadata";
            verbose_print("generating $metadatafile");
            my $checksum = sha256_base64($nugetfile);
            open($fh, '>', $metadatafile) or error("failed to write to $metadatafile");
            print {$fh} << "JSON";
{
  "version": 2,
  "contentHash": "$checksum"
}
JSON
            close($fh) or error("closing $metadatafile: $!");
        }
    }
}

# =============================================================================
# Вспомогательные функции
# =============================================================================
sub get_nuget_metadata {
    my ($nugetfile, $package) = @_;

    my $zip = Archive::Zip->new();
    $zip->read($nugetfile) == AZ_OK or error("$nugetfile read failed: $!");

    my ($nuspec) = grep { m{^[^/]+\.nuspec$}i } $zip->memberNames();
    if ($nuspec) {
        my $content = $zip->memberNamed($nuspec)->contents();
        my $doc = XML::LibXML->new()->parse_string($content);
        my $root = $doc->documentElement();

        my ($id_node) = $root->findnodes('.//*[local-name()="metadata"]/*[local-name()="id"]');
        my ($ver_node) = $root->findnodes('.//*[local-name()="metadata"]/*[local-name()="version"]');

        my $id = $id_node ? clean_text($id_node->textContent()) : undef;
        my $ver = $ver_node ? clean_text($ver_node->textContent()) : undef;

        return ($id, $ver);
    } else {
        error(".nuspec file not found in $nugetfile");
    }
}

sub clean_text {
    my $text = shift;
    $text =~ s/^\s+|\s+$//g;
    return $text;
}
